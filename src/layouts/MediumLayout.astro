---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/medium.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body>
  <div class="medium-container">
    <slot />
  </div>
</body>
</html>