---
import '../styles/medium.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Convo • Project Hub</title>
  <style>
    .channel-modal[hidden] { display: none; }
    .channel-modal {
      position: fixed;
      inset: 0;
      z-index: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      font-family: var(--font-sans);
    }
    .channel-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(2, 7, 13, .78);
      backdrop-filter: blur(8px);
    }
    .channel-modal-card {
      position: relative;
      width: min(420px, 94vw);
      padding: 26px;
      background: rgba(8, 14, 24, .96);
      border: 1px solid rgba(56, 189, 248, .24);
      box-shadow: 0 24px 80px rgba(0, 0, 0, .5), 0 0 32px rgba(56, 189, 248, .08);
      border-radius: 6px;
    }
    .channel-modal-title {
      color: #e9f8ff;
      font-family: var(--font-mono);
      font-size: .72rem;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .channel-modal-subtitle {
      margin-top: 5px;
      color: var(--text-muted);
      font-size: .84rem;
    }
    .channel-modal-field { margin-top: 18px; }
    .channel-modal-label {
      display: block;
      margin-bottom: 7px;
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: .58rem;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .channel-modal-input {
      width: 100%;
      height: 40px;
      padding: 8px 11px;
      border: 1px solid rgba(56, 189, 248, .18);
      border-radius: 3px;
      outline: none;
      background: rgba(3, 10, 17, .86);
      color: #fff;
      font-family: var(--font-sans);
    }
    .channel-modal-input:focus {
      border-color: rgba(56, 189, 248, .58);
      box-shadow: 0 0 16px rgba(56, 189, 248, .08);
    }
    .channel-modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 9px;
      margin-top: 22px;
    }
    .channel-modal-button {
      min-width: 88px;
      height: 36px;
      padding: 0 14px;
      border: 1px solid rgba(56, 189, 248, .22);
      border-radius: 3px;
      background: rgba(56, 189, 248, .05);
      color: #dff8ff;
      font-family: var(--font-mono);
      font-size: .58rem;
      letter-spacing: .1em;
      cursor: pointer;
    }
    .channel-modal-button:hover { border-color: rgba(56, 189, 248, .55); }
    .channel-modal-button.primary {
      background: rgba(37, 99, 235, .2);
      border-color: rgba(56, 189, 248, .4);
    }
    .channel-modal-button:disabled { opacity: .5; cursor: wait; }
    .channel-modal-error {
      min-height: 18px;
      margin-top: 9px;
      color: #fca5a5;
      font-family: var(--font-mono);
      font-size: .58rem;
    }
  </style>
</head>
<body>
  <div id="authOverlay" class="auth-overlay">
    <form id="authForm" class="auth-card" novalidate>
      <div class="hud-corner hud-corner-tl"></div>
      <div class="hud-corner hud-corner-tr"></div>
      <div class="hud-corner hud-corner-bl"></div>
      <div class="hud-corner hud-corner-br"></div>
      <div class="hud-brand">CONVO</div>
      <div class="hud-status" id="hudStatus">ACCESS SYSTEM READY</div>

      <button id="accessCore" class="access-core" type="submit" aria-label="Enter Convo">
        <span class="core-orbit orbit-one"></span>
        <span class="core-orbit orbit-two"></span>
        <span class="core-orbit orbit-three"></span>
        <span class="core-grid"></span>
        <span class="core-center"></span>
        <span class="core-sweep"></span>
      </button>

      <div class="hud-progress" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
      <div class="hud-hint" id="hudHint">ENTER ACCESS CODE</div>

      <input type="password" id="pinInput" class="pin-input-hidden" maxlength="4" inputmode="numeric" autocomplete="off" aria-label="Access code" tabindex="0" />

      <div id="newUserNameBlock" class="new-user-block" style="display: none;">
        <div class="new-user-label">IDENTITY REGISTRATION</div>
        <input type="text" id="nameInput" class="name-field" placeholder="Display name" autocomplete="off" />
      </div>

      <button id="btnLogin" class="hud-enter" type="submit">INITIALIZE</button>
    </form>
  </div>

  <div class="app-layout">
    <aside class="sidebar">
      <div class="brand-section">
        <div class="brand-wrapper">
          <div class="brand-logo">C</div>
          <div class="brand-name">convo</div>
        </div>
        <button id="btnLogout" class="logout-link" type="button">Exit</button>
      </div>
      <nav class="nav-groups">
        <div>
          <div class="nav-header">
            <span class="nav-label">Team Channels</span>
            <button id="btnCreateChannel" class="btn-add-group" onclick="createCustomGroup()" title="Create Channel">+</button>
          </div>
          <div id="channelNavList" class="channel-list"></div>
        </div>
      </nav>
    </aside>

    <section class="main-stage">
      <header class="channel-header">
        <div class="channel-info">
          <h2 id="activeChannelHeading"># general</h2>
          <p id="activeChannelDesc">Common community thread</p>
        </div>
        <div class="header-actions">
          <span id="userDisplayName" class="user-display-name"></span>
          <button id="btnDeleteGroup" class="btn-ctrl danger" style="display: none;" onclick="deleteCurrentGroup()">Delete Channel</button>
        </div>
      </header>
      <main class="chat-scroll-area">
        <section id="superAdminDeck" class="super-admin-deck" style="display: none;">
          <div class="deck-title">🛡️ Super Admin User Authority (PIN: 4999)</div>
          <div id="adminUserRows"></div>
        </section>
        <div id="messagesFeed" style="display: flex; flex-direction: column; gap: 16px;"></div>
      </main>
      <div class="input-dock">
        <form class="input-container" onsubmit="event.preventDefault(); handlePostMessage();">
          <input type="text" id="msgInput" class="chat-input" placeholder="Message this thread..." autocomplete="off" />
          <button type="submit" class="btn-send">Post</button>
        </form>
      </div>
    </section>
  </div>

  <div id="channelModal" class="channel-modal" hidden>
    <div class="channel-modal-backdrop" data-close-channel-modal></div>
    <form id="channelForm" class="channel-modal-card" novalidate>
      <div class="channel-modal-title">Create Channel</div>
      <div class="channel-modal-subtitle">Add a new team discussion channel.</div>

      <div class="channel-modal-field">
        <label class="channel-modal-label" for="channelNameInput">Channel name</label>
        <input id="channelNameInput" class="channel-modal-input" type="text" maxlength="40" placeholder="e.g. development" autocomplete="off" required />
      </div>

      <div class="channel-modal-field">
        <label class="channel-modal-label" for="channelDescriptionInput">Description</label>
        <input id="channelDescriptionInput" class="channel-modal-input" type="text" maxlength="40" placeholder="Project discussion" autocomplete="off" />
      </div>

      <div id="channelModalError" class="channel-modal-error" aria-live="polite"></div>

      <div class="channel-modal-actions">
        <button id="btnCancelChannel" class="channel-modal-button" type="button">Cancel</button>
        <button id="btnSubmitChannel" class="channel-modal-button primary" type="submit">Create</button>
      </div>
    </form>
  </div>

  <script is:inline>
  const WORKER_URL = 'https://convo-api.atityaramsureshmanickam.workers.dev';
  let currentPin = localStorage.getItem('convo_active_pin') || null;
  let currentUser = JSON.parse(localStorage.getItem('convo_user') || 'null');
  let currentChannels = [];
  let activeChannel = null;
  let hiddenPin = '';
  let isLeftShiftHeld = false;
  let isValidSuperAdminAttempt = true;
  let autoSubmitting = false;
  let appLoading = false;

  const authForm = document.getElementById('authForm');
  const pinInput = document.getElementById('pinInput');
  const nameInput = document.getElementById('nameInput');
  const newUserNameBlock = document.getElementById('newUserNameBlock');
  const btnLogin = document.getElementById('btnLogin');
  const btnLogout = document.getElementById('btnLogout');
  const authOverlay = document.getElementById('authOverlay');
  const accessCore = document.getElementById('accessCore');
  const hudStatus = document.getElementById('hudStatus');
  const hudHint = document.getElementById('hudHint');
  const progressSegments = [...document.querySelectorAll('.hud-progress span')];

  const $ = (id) => document.getElementById(id);
  const esc = (value) => String(value ?? '').replace(/[&<>\"']/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', "'": '&#39;'
  }[char]));
  const formatTime = (value) => {
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? '' : date.toLocaleString([], {
      month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
    });
  };

  function focusAccess() { pinInput.focus({ preventScroll: true }); }

  async function api(path, options = {}) {
    const headers = { ...(options.headers || {}) };
    if (options.body !== undefined && !headers['Content-Type']) headers['Content-Type'] = 'application/json';
    if (currentPin) headers['X-Convo-Pin'] = currentPin;

    const response = await fetch(`${WORKER_URL}${path}`, {
      ...options,
      headers,
      cache: 'no-store'
    });

    const text = await response.text();
    let data = {};
    try { data = text ? JSON.parse(text) : {}; } catch { data = { error: text }; }

    if (!response.ok) throw new Error(data.error || `Request failed (${response.status})`);
    return data;
  }

  function showAppError(message) {
    console.error(message);
    hudStatus.textContent = 'CONNECTION ERROR';
    hudHint.textContent = 'CHECK WORKER ACCESS';
  }

  window.addEventListener('keydown', (e) => {
    if (e.code === 'ShiftLeft') {
      isLeftShiftHeld = true;
      authOverlay.classList.add('super-mode');
      hudStatus.textContent = 'ACCESS CORE ARMED';
      hudHint.textContent = 'ENTER ACCESS CODE';
    }
    if (e.code === 'Escape') {
      e.preventDefault();
      hiddenPin = '';
      pinInput.value = '';
      isValidSuperAdminAttempt = true;
      autoSubmitting = false;
      authOverlay.classList.remove('super-mode', 'denied');
      hudStatus.textContent = 'ACCESS SYSTEM READY';
      hudHint.textContent = 'ENTER ACCESS CODE';
      updateHud();
    }
  });

  window.addEventListener('keyup', (e) => {
    if (e.code === 'ShiftLeft') {
      isLeftShiftHeld = false;
      if (!hiddenPin.length) authOverlay.classList.remove('super-mode');
    }
  });

  window.addEventListener('blur', () => {
    isLeftShiftHeld = false;
    if (!hiddenPin.length) authOverlay.classList.remove('super-mode');
  });

  btnLogout.addEventListener('click', handleLogout);

  function handleLogout() {
    closeChannelModal();
    localStorage.removeItem('convo_active_pin');
    localStorage.removeItem('convo_user');
    sessionStorage.removeItem('convo_active_pin');
    sessionStorage.removeItem('convo_user');
    currentPin = null;
    currentUser = null;
    currentChannels = [];
    activeChannel = null;
    hiddenPin = '';
    isValidSuperAdminAttempt = true;
    isLeftShiftHeld = false;
    autoSubmitting = false;
    pinInput.value = '';
    nameInput.value = '';
    newUserNameBlock.style.display = 'none';
    btnLogin.textContent = 'INITIALIZE';
    btnLogin.disabled = false;
    hudStatus.textContent = 'ACCESS SYSTEM READY';
    hudHint.textContent = 'ENTER ACCESS CODE';
    authOverlay.classList.remove('super-mode', 'granted', 'denied', 'checking');
    authOverlay.style.display = 'flex';
    updateHud();
    $('messagesFeed')?.replaceChildren();
    $('channelNavList')?.replaceChildren();
    $('superAdminDeck').style.display = 'none';
    $('userDisplayName').textContent = '';
    $('btnDeleteGroup').style.display = 'none';
    $('btnCreateChannel').style.display = 'none';
    requestAnimationFrame(focusAccess);
  }

  function updateHud() {
    progressSegments.forEach((segment, index) => segment.classList.toggle('filled', index < hiddenPin.length));
    accessCore.style.setProperty('--entry-progress', `${hiddenPin.length * 25}%`);
  }

  pinInput.addEventListener('keydown', (e) => {
    if (e.code === 'ShiftLeft' || e.code === 'ShiftRight' || e.key === 'Tab') return;
    if (e.key === 'Backspace') {
      e.preventDefault();
      hiddenPin = hiddenPin.slice(0, -1);
      pinInput.value = '';
      isValidSuperAdminAttempt = true;
      autoSubmitting = false;
      authOverlay.classList.remove('denied');
      updateHud();
      return;
    }
    const match = e.code.match(/^(Digit|Numpad)(\d)$/);
    if (match && hiddenPin.length < 4) {
      e.preventDefault();
      hiddenPin += match[2];
      pinInput.value = '';
      if (!isLeftShiftHeld) isValidSuperAdminAttempt = false;
      updateHud();
      if (hiddenPin.length === 4 && !autoSubmitting) {
        autoSubmitting = true;
        requestAnimationFrame(() => authForm.requestSubmit());
      }
      return;
    }
    if (e.key === 'Enter') {
      e.preventDefault();
      authForm.requestSubmit();
      return;
    }
    if (!e.ctrlKey && !e.metaKey && !e.altKey) e.preventDefault();
  });

  authForm.addEventListener('submit', (e) => {
    e.preventDefault();
    login();
  });

  accessCore.addEventListener('click', (e) => {
    e.preventDefault();
    if (hiddenPin.length === 4) authForm.requestSubmit();
    else focusAccess();
  });

  async function login() {
    if (hiddenPin.length !== 4) {
      hudStatus.textContent = 'ACCESS CODE REQUIRED';
      authOverlay.classList.add('denied');
      autoSubmitting = false;
      focusAccess();
      return;
    }

    const name = nameInput.value.trim();
    const isSuperAdmin = hiddenPin === '4999';

    try {
      btnLogin.textContent = 'VERIFYING';
      btnLogin.disabled = true;
      hudStatus.textContent = isSuperAdmin ? 'ACCESS CORE VERIFYING' : 'IDENTITY VERIFYING';
      hudHint.textContent = 'AUTHENTICATING';
      authOverlay.classList.remove('denied');
      authOverlay.classList.add('checking');

      const response = await fetch(`${WORKER_URL}/auth`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pin: hiddenPin, name, isSuperAdmin })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Authentication failed');

      if (data.isNew && !name && newUserNameBlock.style.display === 'none') {
        newUserNameBlock.style.display = 'block';
        btnLogin.textContent = 'COMPLETE IDENTITY';
        btnLogin.disabled = false;
        hudStatus.textContent = 'NEW IDENTITY DETECTED';
        hudHint.textContent = 'ENTER DISPLAY NAME';
        authOverlay.classList.remove('checking');
        autoSubmitting = false;
        nameInput.focus();
        return;
      }

      currentPin = hiddenPin;
      currentUser = data.user;
      localStorage.setItem('convo_active_pin', currentPin);
      localStorage.setItem('convo_user', JSON.stringify(currentUser));
      hudStatus.textContent = 'ACCESS GRANTED';
      hudHint.textContent = isSuperAdmin ? 'SUPER ADMIN CORE ONLINE' : 'IDENTITY VERIFIED';
      authOverlay.classList.remove('checking', 'denied');
      authOverlay.classList.add('granted');
      setTimeout(() => { authOverlay.style.display = 'none'; initApp(); }, 360);
    } catch (err) {
      console.error(err);
      hudStatus.textContent = 'ACCESS DENIED';
      hudHint.textContent = 'TRY AGAIN';
      authOverlay.classList.remove('checking', 'granted');
      authOverlay.classList.add('denied');
      btnLogin.textContent = 'INITIALIZE';
      autoSubmitting = false;
      hiddenPin = '';
      pinInput.value = '';
      updateHud();
      alert(err.message || 'Failed to connect to authentication server.');
      focusAccess();
    } finally {
      btnLogin.disabled = false;
    }
  }

  async function loadChannels(preferredName = null) {
    const data = await api('/channels');
    currentChannels = Array.isArray(data.channels) ? data.channels : [];
    renderChannels();

    const targetName = preferredName || activeChannel?.name || 'general';
    const target = currentChannels.find((channel) => channel.name === targetName) || currentChannels[0];
    if (target) await selectChannel(target.name, false);
  }

  function renderChannels() {
    const list = $('channelNavList');
    list.replaceChildren();

    currentChannels.forEach((channel) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'channel-item' + (activeChannel?.id === channel.id ? ' active' : '');
      button.textContent = `# ${channel.name}`;
      button.title = channel.description || channel.name;
      button.addEventListener('click', () => selectChannel(channel.name));
      list.appendChild(button);
    });
  }

  async function selectChannel(channelName, reportActivity = true) {
    const channel = currentChannels.find((item) => item.name === channelName);
    if (!channel) return;
    activeChannel = channel;
    $('activeChannelHeading').textContent = `# ${channel.name}`;
    $('activeChannelDesc').textContent = channel.description || 'Project discussion';
    $('btnDeleteGroup').style.display = channel.name === 'general' || !['admin', 'superadmin'].includes(currentUser?.role) ? 'none' : 'inline-flex';
    renderChannels();
    $('messagesFeed').innerHTML = '<div class="state-message">Loading messages...</div>';

    try {
      const data = await api(`/messages?channel=${encodeURIComponent(channel.name)}`);
      renderMessages(Array.isArray(data.messages) ? data.messages : []);
      if (reportActivity) {
        await api('/activity', {
          method: 'POST',
          body: JSON.stringify({ channel: channel.name, action: 'VIEWED' })
        });
      }
    } catch (err) {
      $('messagesFeed').innerHTML = `<div class="state-message">Unable to load this channel.</div>`;
      showAppError(err);
    }
  }

  function renderMessages(messages) {
    const feed = $('messagesFeed');
    feed.replaceChildren();
    if (!messages.length) {
      const empty = document.createElement('div');
      empty.className = 'state-message';
      empty.textContent = 'No messages yet. Start the conversation.';
      feed.appendChild(empty);
      return;
    }

    messages.forEach((message) => {
      const article = document.createElement('article');
      article.className = 'message-card';
      const own = currentUser && message.pin === currentUser.pin;
      const canDelete = currentUser && (currentUser.role === 'superadmin' || own || (currentUser.role === 'admin' && message.role === 'user'));
      article.innerHTML = `
        <div class="message-meta">
          <strong>${esc(message.author || 'Unknown')}</strong>
          <span>${esc(message.role || 'user')}</span>
          <time>${esc(formatTime(message.time || message.createdAt))}</time>
        </div>
        <div class="message-text">${esc(message.text)}</div>
        ${canDelete ? `<button type="button" class="message-delete" data-message-id="${Number(message.id)}">Delete</button>` : ''}
      `;
      const deleteButton = article.querySelector('.message-delete');
      if (deleteButton) deleteButton.addEventListener('click', () => deleteMessage(message.id));
      feed.appendChild(article);
    });
  }

  async function deleteMessage(id) {
    if (!confirm('Delete this message?')) return;
    try {
      await api(`/messages/${encodeURIComponent(id)}`, { method: 'DELETE' });
      await selectChannel(activeChannel.name, false);
    } catch (err) {
      alert(err.message || 'Unable to delete message.');
    }
  }

  window.handlePostMessage = async function handlePostMessage() {
    if (!currentUser || !activeChannel) return;
    const input = $('msgInput');
    const text = input.value.trim();
    if (!text) return;

    const button = document.querySelector('.btn-send');
    input.disabled = true;
    if (button) button.disabled = true;
    try {
      await api('/messages', {
        method: 'POST',
        body: JSON.stringify({ channel: activeChannel.name, text })
      });
      input.value = '';
      await selectChannel(activeChannel.name, false);
      input.focus();
    } catch (err) {
      alert(err.message || 'Unable to post message.');
    } finally {
      input.disabled = false;
      if (button) button.disabled = false;
    }
  };

  const channelModal = $('channelModal');
  const channelForm = $('channelForm');
  const channelNameInput = $('channelNameInput');
  const channelDescriptionInput = $('channelDescriptionInput');
  const channelModalError = $('channelModalError');
  const btnSubmitChannel = $('btnSubmitChannel');

  function closeChannelModal() {
    channelModal.hidden = true;
    channelForm.reset();
    channelModalError.textContent = '';
    btnSubmitChannel.disabled = false;
    btnSubmitChannel.textContent = 'Create';
  }

  window.createCustomGroup = function createCustomGroup() {
    if (!currentUser || !['admin', 'superadmin'].includes(currentUser.role)) return;
    channelModal.hidden = false;
    channelModalError.textContent = '';
    requestAnimationFrame(() => channelNameInput.focus());
  };

  channelForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!currentUser || !['admin', 'superadmin'].includes(currentUser.role)) return;

    const name = channelNameInput.value.trim();
    const description = channelDescriptionInput.value.trim() || 'Project discussion';

    if (!name) {
      channelModalError.textContent = 'Channel name is required.';
      channelNameInput.focus();
      return;
    }

    btnSubmitChannel.disabled = true;
    btnSubmitChannel.textContent = 'Creating...';
    channelModalError.textContent = '';

    try {
      const data = await api('/channels', {
        method: 'POST',
        body: JSON.stringify({ name, description })
      });
      closeChannelModal();
      await loadChannels(data.channel?.name || name.trim().toLowerCase());
    } catch (err) {
      channelModalError.textContent = err.message || 'Unable to create channel.';
      btnSubmitChannel.disabled = false;
      btnSubmitChannel.textContent = 'Create';
    }
  });

  $('btnCancelChannel').addEventListener('click', closeChannelModal);
  document.querySelector('[data-close-channel-modal]').addEventListener('click', closeChannelModal);

  window.deleteCurrentGroup = async function deleteCurrentGroup() {
    if (!activeChannel || activeChannel.name === 'general') return;
    if (!['admin', 'superadmin'].includes(currentUser?.role)) return;
    if (!confirm(`Delete #${activeChannel.name} and its messages?`)) return;
    try {
      await api(`/channels?id=${encodeURIComponent(activeChannel.id)}`, { method: 'DELETE' });
      activeChannel = null;
      await loadChannels('general');
    } catch (err) {
      alert(err.message || 'Unable to delete channel.');
    }
  };

  async function loadAdminUsers() {
    if (currentUser?.role !== 'superadmin') return;
    const deck = $('superAdminDeck');
    const rows = $('adminUserRows');
    rows.innerHTML = '<div class="state-message">Loading authority data...</div>';
    try {
      const data = await api('/users');
      const users = Array.isArray(data.users) ? data.users : [];
      rows.replaceChildren();
      users.forEach((user) => {
        const row = document.createElement('div');
        row.className = 'admin-user-row';
        row.innerHTML = `
          <span><strong>${esc(user.name)}</strong> · PIN ${esc(user.pin)}</span>
          <span>${esc(user.role)}</span>
          ${user.pin !== currentUser.pin ? `<button type="button" class="btn-ctrl" data-pin="${esc(user.pin)}" data-role="${esc(user.role === 'admin' ? 'user' : 'admin')}">${user.role === 'admin' ? 'Make User' : 'Make Admin'}</button>` : ''}
        `;
        const action = row.querySelector('button');
        if (action) action.addEventListener('click', () => changeUserRole(action.dataset.pin, action.dataset.role));
        rows.appendChild(row);
      });
      deck.style.display = 'block';
    } catch (err) {
      rows.innerHTML = `<div class="state-message">Authority data unavailable.</div>`;
      showAppError(err);
    }
  }

  async function changeUserRole(pin, role) {
    try {
      await api('/users/role', { method: 'PUT', body: JSON.stringify({ pin, role }) });
      await loadAdminUsers();
    } catch (err) {
      alert(err.message || 'Unable to change user role.');
    }
  }

  async function initApp() {
    if (!currentUser || appLoading) return;
    appLoading = true;
    $('userDisplayName').textContent = currentUser.name || '';
    $('superAdminDeck').style.display = currentUser.role === 'superadmin' ? 'block' : 'none';
    $('btnCreateChannel').style.display = ['admin', 'superadmin'].includes(currentUser.role) ? 'inline-flex' : 'none';
    try {
      await loadChannels();
      if (currentUser.role === 'superadmin') await loadAdminUsers();
    } catch (err) {
      $('messagesFeed').innerHTML = '<div class="state-message">Unable to connect to Convo.</div>';
      showAppError(err);
    } finally {
      appLoading = false;
    }
  }

  if (currentPin && currentUser) {
    authOverlay.style.display = 'none';
    initApp();
  } else {
    authOverlay.style.display = 'flex';
    requestAnimationFrame(focusAccess);
  }
</script>
</body>
</html>
