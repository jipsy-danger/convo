---
import '../styles/medium.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Convo • Project Hub</title>
</head>
<body>
  <!-- PIN Authentication Modal -->
  <div id="authOverlay" class="auth-overlay">
    <form id="authForm" class="auth-card">
      <div class="auth-heading">
        <h2>Convo</h2>
        <p>Enter your 4-digit PIN to join the lounge</p>
      </div>

      <input type="password" id="pinInput" class="pin-field" maxlength="4" inputmode="numeric" pattern="[0-9]*" placeholder="••••" autocomplete="off" aria-label="4-digit PIN" />

      <div id="newUserNameBlock" class="new-user-block" style="display: none;">
        <input type="text" id="nameInput" class="name-field" placeholder="Choose your display name" autocomplete="off" />
      </div>

      <button id="btnLogin" class="btn-primary" type="submit">Enter Portal</button>
    </form>
  </div>

  <!-- Main App Shell -->
  <div class="app-layout">
    <aside class="sidebar">
      <div class="brand-section">
        <div class="brand-wrapper">
          <div class="brand-logo">C</div>
          <div class="brand-name">convo</div>
        </div>
        <button id="btnLogout" class="logout-link" type="button">Exit</button>
      </div>

      <nav class="nav-groups">
        <div>
          <div class="nav-header">
            <span class="nav-label">Team Channels</span>
            <button class="btn-add-group" onclick="createCustomGroup()" title="Create Group">+</button>
          </div>
          <div id="channelNavList" class="channel-list"></div>
        </div>
      </nav>
    </aside>

    <section class="main-stage">
      <header class="channel-header">
        <div class="channel-info">
          <h2 id="activeChannelHeading"># general</h2>
          <p id="activeChannelDesc">Common community thread</p>
        </div>
        <div class="header-actions">
          <span id="userDisplayName" class="user-display-name"></span>
          <button id="btnDeleteGroup" class="btn-ctrl danger" style="display: none;" onclick="deleteCurrentGroup()">Delete Channel</button>
        </div>
      </header>

      <main class="chat-scroll-area">
        <section id="superAdminDeck" class="super-admin-deck" style="display: none;">
          <div class="deck-title">🛡️ Super Admin User Authority (PIN: 4999)</div>
          <div id="adminUserRows"></div>
        </section>
        <div id="messagesFeed" style="display: flex; flex-direction: column; gap: 16px;"></div>
      </main>

      <div class="input-dock">
        <form class="input-container" onsubmit="event.preventDefault(); handlePostMessage();">
          <input type="text" id="msgInput" class="chat-input" placeholder="Message this thread..." autocomplete="off" />
          <button type="submit" class="btn-send">Post</button>
        </form>
      </div>
    </section>
  </div>

  <script is:inline>
  const WORKER_URL = 'https://convo-api.atityaramsureshmanickam.workers.dev';

  let currentPin = localStorage.getItem('convo_active_pin') || null;
  let currentUser = JSON.parse(localStorage.getItem('convo_user') || 'null');

  let hiddenPin = '';
  let isLeftShiftHeld = false;
  let isValidSuperAdminAttempt = true;

  window.addEventListener('keydown', (e) => {
    if (e.code === 'ShiftLeft') isLeftShiftHeld = true;
  });
  window.addEventListener('keyup', (e) => {
    if (e.code === 'ShiftLeft') isLeftShiftHeld = false;
  });

  const authForm = document.getElementById('authForm');
  const pinInput = document.getElementById('pinInput');
  const nameInput = document.getElementById('nameInput');
  const newUserNameBlock = document.getElementById('newUserNameBlock');
  const btnLogin = document.getElementById('btnLogin');
  const btnLogout = document.getElementById('btnLogout');
  const authOverlay = document.getElementById('authOverlay');

  // Exit must be a real button action, not an inline onclick dependency.
  btnLogout.addEventListener('click', handleLogout);

  function handleLogout() {
    localStorage.removeItem('convo_active_pin');
    localStorage.removeItem('convo_user');
    sessionStorage.removeItem('convo_active_pin');
    sessionStorage.removeItem('convo_user');

    currentPin = null;
    currentUser = null;
    hiddenPin = '';
    isValidSuperAdminAttempt = true;
    isLeftShiftHeld = false;

    pinInput.value = '';
    nameInput.value = '';
    newUserNameBlock.style.display = 'none';
    btnLogin.textContent = 'Enter Portal';
    btnLogin.disabled = false;
    authOverlay.style.display = 'flex';

    const feed = document.getElementById('messagesFeed');
    const channels = document.getElementById('channelNavList');
    const deck = document.getElementById('superAdminDeck');
    const userName = document.getElementById('userDisplayName');

    if (feed) feed.replaceChildren();
    if (channels) channels.replaceChildren();
    if (deck) deck.style.display = 'none';
    if (userName) userName.textContent = '';

    pinInput.focus();
  }

  pinInput.addEventListener('keydown', (e) => {
    if (e.key === 'Backspace') {
      e.preventDefault();
      hiddenPin = hiddenPin.slice(0, -1);
      pinInput.value = '•'.repeat(hiddenPin.length);
      isValidSuperAdminAttempt = true;
      return;
    }

    const match = e.code.match(/^(Digit|Numpad)(\d)$/);
    if (match && hiddenPin.length < 4) {
      e.preventDefault();
      const digit = match[2];
      hiddenPin += digit;
      pinInput.value = '•'.repeat(hiddenPin.length);
      if (!isLeftShiftHeld) isValidSuperAdminAttempt = false;
      return;
    }

    // Let Enter reach the auth form so keyboard login works without a mouse.
    if (e.key !== 'Enter' && e.key !== 'Tab') e.preventDefault();
  });

  // The authentication form owns submission. Enter now behaves exactly like clicking Enter Portal.
  authForm.addEventListener('submit', (e) => {
    e.preventDefault();
    login();
  });

  async function login() {
    if (hiddenPin.length !== 4) {
      alert('Enter a 4-digit PIN');
      pinInput.focus();
      return;
    }

    const name = nameInput.value.trim();
    const isSuperAdmin = hiddenPin === '4999' && isValidSuperAdminAttempt;

    try {
      btnLogin.textContent = 'Verifying...';
      btnLogin.disabled = true;

      const res = await fetch(`${WORKER_URL}/auth`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pin: hiddenPin, name, isSuperAdmin })
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Authentication failed');

      if (data.isNew && !name && newUserNameBlock.style.display === 'none') {
        newUserNameBlock.style.display = 'block';
        btnLogin.textContent = 'Complete Registration';
        btnLogin.disabled = false;
        alert('New PIN detected! Choose a display name to create your profile.');
        nameInput.focus();
        return;
      }

      currentPin = hiddenPin;
      currentUser = data.user;
      localStorage.setItem('convo_active_pin', currentPin);
      localStorage.setItem('convo_user', JSON.stringify(currentUser));

      authOverlay.style.display = 'none';
      initApp();
    } catch (err) {
      console.error(err);
      alert(err.message || 'Failed to connect to authentication server.');
      btnLogin.textContent = 'Enter Portal';
    } finally {
      btnLogin.disabled = false;
    }
  }

  if (currentPin && currentUser) {
    authOverlay.style.display = 'none';
    initApp();
  } else {
    authOverlay.style.display = 'flex';
    requestAnimationFrame(() => pinInput.focus());
  }

  function initApp() {
    if (!currentUser) return;
    document.getElementById('userDisplayName').textContent = currentUser.name || '';
    const deck = document.getElementById('superAdminDeck');
    deck.style.display = currentUser.role === 'superadmin' ? 'block' : 'none';
  }
</script>
</body>
</html>