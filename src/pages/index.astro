---
import '../styles/medium.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Convo • Project Hub</title>
</head>
<body>
  <!-- PIN Authentication Modal -->
  <div id="authOverlay" class="auth-overlay">
    <div class="auth-card">
      <h2>Convo</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Enter your 4-digit PIN to join the lounge</p>
      
      <input type="password" id="pinInput" class="pin-field" maxlength="4" placeholder="••••" autocomplete="off" />
      
      <div id="newUserNameBlock" style="display: none;">
        <input type="text" id="nameInput" class="name-field" placeholder="Choose your display name" />
      </div>
      
      <button id="btnLogin" class="btn-primary">Enter Portal</button>
    </div>
  </div>

  <!-- Main App Shell -->
  <div class="app-layout">
    <!-- Left Navigation Sidebar -->
    <aside class="sidebar">
      <div class="brand-section">
        <div class="brand-wrapper">
          <div class="brand-logo">C</div>
          <div class="brand-name">convo</div>
        </div>
        <span class="logout-link" onclick="handleLogout()">Exit</span>
      </div>

      <nav class="nav-groups">
        <div>
          <div class="nav-header">
            <span class="nav-label">Team Channels</span>
            <button class="btn-add-group" onclick="createCustomGroup()" title="Create Group">+</button>
          </div>
          <div id="channelNavList" class="channel-list">
            <!-- Dynamic Channels -->
          </div>
        </div>
      </nav>
    </aside>

    <!-- Right Workspace Stage -->
    <section class="main-stage">
      <header class="channel-header">
        <div class="channel-info">
          <h2 id="activeChannelHeading"># general</h2>
          <p id="activeChannelDesc">Common community thread</p>
        </div>
        <div class="header-actions">
          <span id="userDisplayName" class="user-display-name"></span>
          <button id="btnDeleteGroup" class="btn-ctrl danger" style="display: none;" onclick="deleteCurrentGroup()">Delete Channel</button>
        </div>
      </header>

      <main class="chat-scroll-area">
        <!-- Super Admin Control Deck (Only rendered for PIN 4999) -->
        <section id="superAdminDeck" class="super-admin-deck" style="display: none;">
          <div class="deck-title">🛡️ Super Admin User Authority (PIN: 4999)</div>
          <div id="adminUserRows"></div>
        </section>

        <!-- Message List -->
        <div id="messagesFeed" style="display: flex; flex-direction: column; gap: 16px;"></div>
      </main>

      <div class="input-dock">
        <form class="input-container" onsubmit="event.preventDefault(); handlePostMessage();">
          <input type="text" id="msgInput" class="chat-input" placeholder="Message this thread..." autocomplete="off" />
          <button type="submit" class="btn-send">Post</button>
        </form>
      </div>
    </section>
  </div>

  <script is:inline>
    // Local DB Engine
    let users = JSON.parse(localStorage.getItem('convo_users')) || {
      '4999': { name: 'Atitya', role: 'superadmin' }
    };

    let channels = JSON.parse(localStorage.getItem('convo_channels')) || {
      'general': { title: '# general', desc: 'Common community thread', owner: '4999', isDefault: true },
      'robotics': { title: '⚡ robotics-core', desc: 'Hardware, firmware & ROS 2 nodes', owner: '4999', isDefault: false },
      'open-source': { title: '🌐 os-lab', desc: 'Open Source Lab coordination', owner: '4999', isDefault: false }
    };

    let messages = JSON.parse(localStorage.getItem('convo_messages')) || {
      'general': [
        { id: 1, author: 'Atitya', pin: '4999', time: '10:00', text: 'Welcome to Convo! All project chat history is preserved for everyone.' }
      ],
      'robotics': [
        { id: 2, author: 'Atitya', pin: '4999', time: '10:05', text: 'ESP32 micro-ROS node initialized.' }
      ],
      'open-source': []
    };

    let currentPin = localStorage.getItem('convo_active_pin') || null;
    let activeChannel = 'general';

    function saveState() {
      localStorage.setItem('convo_users', JSON.stringify(users));
      localStorage.setItem('convo_channels', JSON.stringify(channels));
      localStorage.setItem('convo_messages', JSON.stringify(messages));
    }

    // Auth Engine
    const authOverlay = document.getElementById('authOverlay');
    const pinInput = document.getElementById('pinInput');
    const newUserNameBlock = document.getElementById('newUserNameBlock');
    const nameInput = document.getElementById('nameInput');
    const btnLogin = document.getElementById('btnLogin');

    if (currentPin && users[currentPin]) {
      authOverlay.style.display = 'none';
      initApp();
    }

    btnLogin.addEventListener('click', () => {
      const pin = pinInput.value.trim();
      const name = nameInput.value.trim();

      if (pin.length !== 4) return alert('Enter a 4-digit PIN');

      if (!users[pin]) {
        if (!name && newUserNameBlock.style.display === 'none') {
          newUserNameBlock.style.display = 'block';
          alert('New PIN detected! Choose a display name.');
          return;
        }
        users[pin] = {
          name: name || `User-${pin}`,
          role: pin === '4999' ? 'superadmin' : 'user'
        };
      }

      currentPin = pin;
      localStorage.setItem('convo_active_pin', pin);
      saveState();
      authOverlay.style.display = 'none';
      initApp();
    });

    function handleLogout() {
      localStorage.removeItem('convo_active_pin');
      location.reload();
    }

    function initApp() {
      const user = users[currentPin];
      document.getElementById('userDisplayName').textContent = user.name;
      
      renderChannels();
      renderFeed();
      renderAdminDeck();
    }

    // Channel Engine
    function renderChannels() {
      const list = document.getElementById('channelNavList');
      list.innerHTML = Object.entries(channels).map(([key, ch]) => `
        <div class="nav-item ${key === activeChannel ? 'active' : ''}" onclick="switchChannel('${key}')">
          <span>${ch.title}</span>
        </div>
      `).join('');

      const curr = channels[activeChannel];
      document.getElementById('activeChannelHeading').textContent = curr.title;
      document.getElementById('activeChannelDesc').textContent = curr.desc;

      // Group Delete permission: Admin / SuperAdmin can delete non-default channels
      const btnDelGroup = document.getElementById('btnDeleteGroup');
      const user = users[currentPin];
      if (!curr.isDefault && (user.role === 'superadmin' || user.role === 'admin')) {
        btnDelGroup.style.display = 'block';
      } else {
        btnDelGroup.style.display = 'none';
      }
    }

    function switchChannel(key) {
      activeChannel = key;
      renderChannels();
      renderFeed();
    }

    function createCustomGroup() {
      const name = prompt('Channel Name (e.g. # backend):');
      if (!name) return;
      const desc = prompt('Channel Description:') || 'Custom project discussion';
      const key = name.toLowerCase().replace(/[^a-z0-9]/g, '-');

      if (channels[key]) return alert('Channel exists');

      channels[key] = {
        title: name,
        desc: desc,
        owner: currentPin,
        isDefault: false
      };
      messages[key] = [];
      saveState();
      switchChannel(key);
    }

    function deleteCurrentGroup() {
      if (confirm(`Delete channel "${channels[activeChannel].title}"?`)) {
        delete channels[activeChannel];
        delete messages[activeChannel];
        activeChannel = 'general';
        saveState();
        renderChannels();
        renderFeed();
      }
    }

    // Message Engine
    function canEdit(msg) {
      if (currentPin === '4999') return true;
      return msg.pin === currentPin;
    }

    function canDelete(msg) {
      if (currentPin === '4999') return true;
      const user = users[currentPin];
      if (user.role === 'admin' && msg.pin !== '4999') return true;
      return false;
    }

    function renderFeed() {
      const container = document.getElementById('messagesFeed');
      const feed = messages[activeChannel] || [];

      container.innerHTML = feed.map(m => `
        <article class="message-card">
          <div class="msg-meta">
            <span class="msg-author">${m.author}</span>
            <span class="msg-time">${m.time}</span>
            <div class="msg-actions">
              ${canEdit(m) ? `<button class="btn-ctrl" onclick="editMessage(${m.id})">Edit</button>` : ''}
              ${canDelete(m) ? `<button class="btn-ctrl danger" onclick="deleteMessage(${m.id})">Del</button>` : ''}
            </div>
          </div>
          <div class="msg-body">${m.text}</div>
        </article>
      `).join('');

      const scrollArea = document.querySelector('.chat-scroll-area');
      scrollArea.scrollTop = scrollArea.scrollHeight;
    }

    function handlePostMessage() {
      const input = document.getElementById('msgInput');
      const text = input.value.trim();
      if (!text) return;

      const now = new Date();
      const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;

      if (!messages[activeChannel]) messages[activeChannel] = [];

      messages[activeChannel].push({
        id: Date.now(),
        author: users[currentPin].name,
        pin: currentPin,
        time: timeStr,
        text: text
      });

      input.value = '';
      saveState();
      renderFeed();
    }

    function editMessage(id) {
      const msg = messages[activeChannel].find(m => m.id === id);
      if (!msg) return;
      const newText = prompt('Edit message:', msg.text);
      if (newText) {
        msg.text = newText;
        saveState();
        renderFeed();
      }
    }

    function deleteMessage(id) {
      messages[activeChannel] = messages[activeChannel].filter(m => m.id !== id);
      saveState();
      renderFeed();
    }

    // Super Admin Engine (PIN 4999)
    function renderAdminDeck() {
      const deck = document.getElementById('superAdminDeck');
      if (currentPin !== '4999') {
        deck.style.display = 'none';
        return;
      }
      deck.style.display = 'block';

      const userRows = document.getElementById('adminUserRows');
      userRows.innerHTML = Object.entries(users).map(([pin, u]) => `
        <div class="admin-user-row">
          <span><strong>${u.name}</strong> (PIN: ${pin}) - [${u.role}]</span>
          ${pin !== '4999' ? `
            <div>
              <button class="btn-ctrl" onclick="toggleRole('${pin}')">
                Toggle to ${u.role === 'admin' ? 'User' : 'Admin'}
              </button>
            </div>
          ` : '<em>Super Admin Master</em>'}
        </div>
      `).join('');
    }

    function toggleRole(pin) {
      users[pin].role = users[pin].role === 'admin' ? 'user' : 'admin';
      saveState();
      renderAdminDeck();
    }
  </script>
</body>
</html>