---
import '../styles/medium.css';
import '../styles/access-fix.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Convo • Project Hub</title>
</head>
<body>
  <div id="authOverlay" class="auth-overlay">
    <form id="authForm" class="auth-card" novalidate onsubmit="return false;">
      <div class="hud-brand">CONVO</div><div class="hud-status" id="hudStatus">ACCESS SYSTEM READY</div>
      <button id="accessCore" class="access-core" type="button" aria-label="Enter Convo"><span class="core-orbit orbit-one"></span><span class="core-orbit orbit-two"></span><span class="core-orbit orbit-three"></span><span class="core-grid"></span><span class="core-center"></span><span class="core-sweep"></span></button>
      <div class="hud-progress" aria-hidden="true"><span></span><span></span><span></span><span></span></div><div class="hud-hint" id="hudHint">ENTER ACCESS CODE</div>
      <input type="password" id="pinInput" class="pin-input-hidden" maxlength="4" inputmode="numeric" autocomplete="off" aria-label="Access code" tabindex="0" />
      <div id="newUserNameBlock" class="new-user-block" style="display:none"><div class="new-user-label">IDENTITY REGISTRATION</div><input type="text" id="nameInput" class="name-field" placeholder="Display name" autocomplete="off" /></div>
      <button id="btnLogin" class="hud-enter" type="submit">INITIALIZE</button>
    </form>
  </div>
  <div class="app-layout">
    <aside class="sidebar"><div class="brand-section"><div class="brand-wrapper"><div class="brand-logo">C</div><div class="brand-name">convo</div></div><button id="btnLogout" class="logout-link" type="button">Exit</button></div><nav class="nav-groups"><div><div class="nav-header"><span class="nav-label">Team Channels</span><button id="btnCreateChannel" class="btn-add-group" onclick="createCustomGroup()" title="Create Channel">+</button></div><div id="channelNavList" class="channel-list"></div></div></nav></aside>
    <section class="main-stage"><header class="channel-header"><div class="channel-info"><h2 id="activeChannelHeading"># general</h2><p id="activeChannelDesc">Common community thread</p></div><div class="header-actions"><span id="userDisplayName" class="user-display-name"></span><button id="btnDeleteGroup" class="btn-ctrl danger" style="display:none" onclick="deleteCurrentGroup()">Delete Channel</button></div></header><main class="chat-scroll-area"><div id="messagesFeed" style="display:flex;flex-direction:column;gap:16px"></div></main><div class="input-dock"><form class="input-container" onsubmit="event.preventDefault();handlePostMessage()"><input type="text" id="msgInput" class="chat-input" placeholder="Message this thread..." autocomplete="off" /><button type="submit" class="btn-send">Post</button></form></div></section>
  </div>
  <button id="superAdminLauncher" class="super-admin-launcher" type="button" aria-label="Open admin panel" hidden>J</button>
  <aside id="superAdminPanel" class="super-admin-panel" aria-hidden="true"><div class="super-panel-head"><div><div class="super-panel-kicker">CONVO / CONTROL</div><h2>Admin Console</h2><p>Authority, activity and access management.</p></div><button id="superPanelClose" class="super-panel-close" type="button" aria-label="Close admin panel">×</button></div><div class="super-panel-stats" id="superAdminStats"><div><b>—</b><span>Users</span></div><div><b>—</b><span>Admins</span></div><div><b>—</b><span>Messages</span></div><div><b>—</b><span>Active</span></div></div><section class="super-panel-section"><div class="super-panel-section-head"><div><span>USER AUTHORITY</span><small>Change normal users to admin or back.</small></div><button id="superPanelRefresh" class="super-panel-refresh" type="button">Refresh</button></div><div id="adminUserRows" class="admin-user-rows"><div class="state-message">Open the panel to load authority data.</div></div></section><section class="super-panel-section"><div class="super-panel-section-head"><div><span>ACTIVITY</span><small>Current system totals.</small></div></div><div id="superAdminActivity" class="super-panel-activity">Waiting for analytics…</div></section></aside>
  <div id="channelModal" class="channel-modal" hidden><div class="channel-modal-backdrop" data-close-channel-modal></div><form id="channelForm" class="channel-modal-card" novalidate><div class="channel-modal-title">Create Channel</div><div class="channel-modal-subtitle">Add a new team discussion channel.</div><div class="channel-modal-field"><label class="channel-modal-label" for="channelNameInput">Channel name</label><input id="channelNameInput" class="channel-modal-input" type="text" maxlength="40" placeholder="e.g. development" autocomplete="off" required /></div><div class="channel-modal-field"><label class="channel-modal-label" for="channelDescriptionInput">Description</label><input id="channelDescriptionInput" class="channel-modal-input" type="text" maxlength="40" placeholder="Project discussion" autocomplete="off" /></div><div id="channelModalError" class="channel-modal-error" aria-live="polite"></div><div class="channel-modal-actions"><button id="btnCancelChannel" class="channel-modal-button" type="button">Cancel</button><button id="btnSubmitChannel" class="channel-modal-button primary" type="submit">Create</button></div></form></div>
  <script src={`${import.meta.env.BASE_URL}convo.js`}></script>
  <script src={`${import.meta.env.BASE_URL}access-runtime-fix.js`}></script>
</body>
</html>
